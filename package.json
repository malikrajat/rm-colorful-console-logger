{
  "name": "rm-colorful-console-logger",
  "description": "A lightweight, zero-dependency library for colorful console logging with customizable colors and bold styling. Provides a simple Log class API (success, error, info) for styled terminal output in Node.js, Deno, Bun, browsers, React, Vue, Angular, Svelte, Next.js, Electron, and any JavaScript/TypeScript project.",
  "version": "2.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsup  && node copy-extra-files.js",
    "dev": "tsup --watch",
    "prepare": "npm run build"
  },
