{
  "name": "rm-colorful-console-logger",
  "description": "A lightweight, zero-dependency library for colorful console logging with customizable colors and bold styling. Provides a simple Log class API (success, error, info) for styled terminal output in Node.js and browser environments.",
  "version": "2.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsup  && node copy-extra-files.js",
    "dev": "tsup --watch",
    "prepare": "npm run build"
  },
  "keywords": [
    "console",
    "logger",
    "log",
    "color",
    "colour",
    "colorize",
    "colorful",
    "terminal",
    "cli",
    "debug",
    "debugging",
    "logging",
    "console.log",
    "output",
    "terminal-log",
    "pretty-print",
    "stylish",
    "styled-logs",
    "console-colors",
    "node",
    "javascript",
    "typescript"
  ],
  "homepage": "https://github.com/malikrajat/rm-colorful-console-logger#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malikrajat/rm-colorful-console-logger.git"
  },
  "bugs": {
    "url": "https://github.com/malikrajat/rm-colorful-console-logger/issues"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "author": {
    "name": "Rajat Malik",
    "email": "mr.rajatmalik@gmail.com",
    "url": "https://www.rajatmalik.dev/"
  },
  "contributors": [
    {
      "name": "Rajat Malik",
      "email": "mr.rajatmalik@gmail.com"
    }
  ],
  "maintainers": [
    {
      "name": "Rajat Malik",
      "email": "mr.rajatmalik@gmail.com"
    }
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/malikrajat"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
